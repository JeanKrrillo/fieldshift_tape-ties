# ============================================================================
# ARCHIVO DE CONFIGURACIÓN DE LLAVES REALES (.env) - FIELD SHIFT 2026
# Copia este archivo como ".env" dentro de la carpeta backend/
# ============================================================================

# 1. NASA EARTHDATA LOGIN (Conecta: AppEEARS, SMAP, GPM IMERG, HLS, ECOSTRESS y GEDI)
# Donde sacarla gratis en 1 minuto:
# Entra a https://urs.earthdata.nasa.gov/ -> Inicia sesion -> Pestaña "Generate Token" -> Copia el token largo
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=

# 2. USDA AMS MYMARKETNEWS API (Conecta: Precios reales en vivo de Maiz, Soya, Sorgo, Forraje y Fertilizantes)
# Donde sacarla gratis en 1 minuto:
# Entra a https://mymarketnews.ams.usda.gov/ -> Registrate / Inicia sesion -> Mi Perfil -> Copia tu "API Key"
USDA_MARS_API_KEY=

# 3. OPENET API (Conecta: Evapotranspiracion real a 30m de los 6 modelos satelitales)
# Donde sacarla gratis:
# Entra a https://account.etdata.org/ -> Crea cuenta -> Copia el token de la seccion "API Key"
OPENET_API_KEY=

# 4. USGS EROS MACHINE-TO-MACHINE (Opcional - solo si quieres descargas masivas directas de EarthExplorer)
# Entra a https://ers.cr.usgs.gov/ -> Application Tokens
USGS_EROS_USERNAME=
USGS_EROS_TOKEN=
